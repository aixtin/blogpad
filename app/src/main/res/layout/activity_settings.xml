<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7F8"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A1A1E"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="连接与站点"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="保存"
            android:textColor="#6FA0FF"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp"
                android:text="SSH 连接"
                android:textColor="#1A1A1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:hint="主机地址（IP 或域名）"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#FFFFFF"
                    android:hint="端口"
                    android:inputType="number"
                    android:padding="12dp"
                    android:text="22"
                    android:textColor="#1A1A1E"
                    android:textColorHint="#9AA0A8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/etUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="2"
                    android:background="#FFFFFF"
                    android:hint="用户名"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#1A1A1E"
                    android:textColorHint="#9AA0A8"
                    android:textSize="14sp" />
            </LinearLayout>

            <RadioGroup
                android:id="@+id/rgAuth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:orientation="horizontal"
                android:padding="8dp">

                <RadioButton
                    android:id="@+id/rbKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="私钥"
                    android:textColor="#1A1A1E"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbPassword"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="密码"
                    android:textColor="#1A1A1E"
                    android:textSize="14sp" />
            </RadioGroup>

            <EditText
                android:id="@+id/etPrivateKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:gravity="top|start"
                android:hint="粘贴 OpenSSH 私钥全文（文本以 BEGIN 开头、END 结尾）"
                android:inputType="textMultiLine|textNoSuggestions"
                android:minLines="4"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="12sp"
                android:typeface="monospace" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnImportKey"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="从文件导入私钥"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnClearKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="清空"
                    android:textSize="13sp" />
            </LinearLayout>

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="登录密码"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etPassphrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="私钥口令（私钥无密码可留空）"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnTest"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="测试连接"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:text="Hugo 站点"
                android:textColor="#1A1A1E"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etSiteRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:hint="站点根目录，如 /var/www/example.com"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etPostDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="文章目录，如 content/post"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etBuildCmd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="构建命令，如 hugo --gc --minify"
                android:inputType="text"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etSiteUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="站点地址，如 https://example.com"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/etLinkTemplate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFFFFF"
                android:hint="文章链接模板，如 https://example.com/archives/{slug}/"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#1A1A1E"
                android:textColorHint="#9AA0A8"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:text="说明：私钥口令与密码经由 Android Keystore 加密后保存在本机。首次连接会显示服务器指纹，确认后记住。"
                android:textColor="#9AA0A8"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvTestStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="24dp"
                android:text=""
                android:textColor="#2F6FED"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
